<mxfile host="app.diagrams.net">
  <diagram id="uml-bank" name="Klassendiagramm Bank">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Package bank -->
        <mxCell id="pkg" value="bank" style="shape=folder;fontStyle=1;tabWidth=80;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="930" height="970" as="geometry" />
        </mxCell>

        <!-- Interface CalculateBill -->
        <mxCell id="iface" value="«interface»&#xa;CalculateBill" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="300" height="66" as="geometry" />
        </mxCell>
