          <mxGeometry y="40" width="300" height="26" as="geometry" />
        </mxCell>

        <!-- Abstract class Transaction -->
        <mxCell id="trans" value="Transaction" style="swimlane;fontStyle=3;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="380" height="298" as="geometry" />
